{
  "name": "gatsby-source-ridewithgps",
  "version": "0.0.0",
  "description": "Gatsby plugin to use RideWithGPS routes as a data source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/gatsby-source-ridewithgps.git"
  },
  "author": "Cédric Delpoux",
  "license": "MIT",
  "private": false,
  "keywords": [
    "gatsby",
    "gatsby-plugin",
    "gatsby-source",
    "ridewithgps"
  ],
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "gatsby-node.js",
    "scripts",
    "utils",
    "docs"
  ],
  "dependencies": {
    "inquirer": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "gatsby": ">=3.0.0"
  },
  "scripts": {
    "lint": "eslint *.js scripts utils test",
    "test": "node --test",
    "prepublishOnly": "yarn lint && yarn test",
    "prepare": "husky"
  },
  "bin": {
    "gatsby-source-ridewithgps-token": "scripts/token.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint"
    ],
    "*.{css,js,md}": [
      "prettier --write"
    ]
  }
}
